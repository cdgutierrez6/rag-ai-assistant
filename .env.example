# ─────────────────────────────────────────────
# RAG AI Assistant — Required Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# Claude / Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-4-7

# PostgreSQL — REQUIRED, no defaults for security
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change_me_use_strong_password

# App database connection (must match the above credentials)
DATABASE_URL=postgresql://rag_user:change_me_use_strong_password@localhost:5432/rag_db

# Chunking settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
MAX_FILE_SIZE_MB=50

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000
